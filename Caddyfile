# Internal HTTP proxy and legacy-host redirect for the self-hosted transparency
# API. Cloudflare terminates public TLS; Caddy is bound to loopback only.

http://{$SITE_ADDRESS:api.krm.fyi} {
	encode zstd gzip

	# App emits its own HSTS + security headers and runs uvicorn with
	# --proxy-headers, so it reads the real client IP from X-Forwarded-For
	# (used by the per-IP rate limits on /api/explore, /api/ask, /api/narratives).
	reverse_proxy web:8080

	# Route Caddy's access logs to stdout (visible via `docker compose logs caddy`).
	log {
		output stdout
		format console
	}
}

# Keep both former public hostnames working while making api.krm.fyi canonical.
# {uri} preserves both the request path and query string.
http://transparency.krm.fyi, http://transparency.kieranmaynard.com {
	redir https://api.krm.fyi{uri} 308
}

# Preserve every legacy website path and query while moving the primary site.
http://kieranmaynard.com, http://www.kieranmaynard.com {
	redir https://krm.fyi{uri} 308
}
